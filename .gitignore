# Python environment (recreate: see README "Setup")
dev/luaenv/
__pycache__/
*.pyc

# Test-run output written by dev/tf_e/run_all.py (the runner itself is tracked)
dev/tf_e/*/

# Scratch / backups
*.bak
*.bak_verify
backup/

# Cached download of Blizzard's UI source used by the API audit (re-fetch with dev/tests/client-api/fetch.sh)
dev/tests/client-api/src/
dev/tests/client-api/tree.json
dev/tests/client-api/commit_*.json

# In-game update signing key (private) and packaged releases
dev/keys/
dist/
dev/tf_e/*.log
dev/releases/undone/
dev/art/wmo/
dev/art/casc/
dev/art/rooms/

# WoWSims TBC item database downloaded by dev/generators/gen_gems.py
dev/generators/data/wowsims_tbc_db.json

# WoWSims spec presets / gear sets downloaded by gen_gems.py
dev/generators/data/wowsims_specs/

# Compiled-bytecode cache of the addon files (dev/tools/harness.py)
dev/.luacache/
dev/tf_e/timings.json
dev/.testmap/
dev/art/tbcdb/
dev/art/azw/
dev/art/dc_db2/
dev/art/framexml/
dev/art/dc_outfits.pickle

# WoWSims TBC source (MIT), cloned for the gear-sim port + match check
dev/ext/
dev/tools/gearsim/logs/
# The guild's feedback read from the saved variables (tools/feedback.py): members' words, not for git
dev/feedback/
