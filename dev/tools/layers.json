  ["^Core/Strategy\\w*\\.lua$", "Strategy"],
  ["^UI/Strateg\\w*\\.lua$", "Strategy"],

  ["^Render3D/Probe\\.lua$", "Dev"],
  ["^Render3D/", "Render3D"],

  ["^Core/(Event\\w*|Polls)\\.lua$", "Events"],
  ["^UI/(Event\\w*|PollsTab)\\.lua$", "Events"],

  ["^Core/(CombatLog|MyLog|MyLogDemo|Meter|Threat|MeterDemo)\\.lua$", "Combat"],
  ["^UI/(MyLog\\w*|Meter\\w*)\\.lua$", "Combat"],

  ["^Data/Classes/", "ClassTools"],
  ["^Core/(SwingTimer|SwingPractice|ShotTimer|ClassPlanner|Blessings|Totems)\\.lua$", "ClassTools"],
  ["^UI/(SwingTimerHUD|RingFace|SwingPracticeUI|ShotTimerHUD|PlannerWindow|BlessingsUI|BarFace|ClassBar|BlessingsBar|TotemsUI|TotemBar)\\.lua$", "ClassTools"],

  ["^UI/(Style|Widgets|Popup|Menu|TooltipSkin|DatePicker)\\.lua$", "Kit"],
  ["^UI/Comp/", "Kit"],
  ["^UI/(MainFrame|NavMenu|MinimapArc|Dashboard|Settings|Changelog|Notify|NotifySources|PerfUI|Share|ShareWindow|Tour|WelcomeTour|PatchUI)\\.lua$", "Shell"],
  ["^Data/Changelog\\.lua$", "Shell"],

  ["^Logic/(Context|Items|Gear|Guild|Raids|Loot|Events|Strategy|Combat|ClassTools)/", "\\1"],
  ["^UI/Kit/", "Kit"],
  ["^UI/(Shell|Tours|Dev)/", "\\1"],
  ["^UI/(Gear|Guild|Raids|Loot|Events|Strategy|Combat|ClassTools)/", "\\1"],

  ["^Core/", "Platform"],
  ["^Games/", "Games"],
  ["^Data/", "Data"]
 ],
 "feature_order": [["Context"], ["Items"], ["Gear"], ["Guild"], ["Raids"], ["Loot"], ["Events", "Strategy", "Combat", "ClassTools"]],
 "logic_layers": [2, 3],
 "kit": {
  "feature": "Kit",
  "forbidden": ["Gear", "Guild", "Raids", "Loot", "Events", "Strategy", "Combat", "ClassTools", "Shell", "Tours", "Dev", "Games"],
  "min_target_layer": 2
 },
 "wire": {
  "Comm": "^(Send|Register|RateLimit|Fits|AllowLarge|Backlog)",
  "DigestSync": "."
 }
}
